{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "version",
    "status",
    "rules"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "RETIRED"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "assert",
          "on_violation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "when": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool"
                ],
                "properties": {
                  "tool": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "side_effect"
                ],
                "properties": {
                  "side_effect": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool_not_in"
                ],
                "properties": {
                  "tool_not_in": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    }
                  }
                }
              }
            ]
          },
          "assert": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "approval.status"
                ],
                "properties": {
                  "approval.status": {
                    "const": "APPROVED"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "args.amount_lte"
                ],
                "properties": {
                  "args.amount_lte": {
                    "const": "context.order_amount"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "args.idempotency_key_present"
                ],
                "properties": {
                  "args.idempotency_key_present": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "always"
                ],
                "properties": {
                  "always": {
                    "const": false
                  }
                }
              }
            ]
          },
          "on_violation": {
            "const": "BLOCK"
          }
        }
      }
    }
  }
}
